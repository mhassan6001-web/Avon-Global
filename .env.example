# Copy to .env for local development. Never commit .env.
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=console
# DATABASE_URL and REDIS_URL are set by docker-compose for the dev containers.
# DATABASE_URL=postgresql+psycopg://aven:aven_dev_password@localhost:5432/aven_global
# REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true
CORS_ORIGINS=http://localhost:3000
DATABASE_STATEMENT_TIMEOUT_MS=15000
READINESS_CHECK_TIMEOUT_SECONDS=2

# --- Identity and security (Stage 2) ---
PUBLIC_BASE_URL=http://localhost:3000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
STEP_UP_MINUTES=5
INVITATION_VALID_HOURS=72
RESET_LINK_VALID_MINUTES=60
MAX_UPLOAD_MB=25
# Production MUST set these (the API refuses to start with the dev defaults):
# FIELD_ENCRYPTION_KEYS=<Fernet key; comma-separate to rotate, first encrypts>
# SIGNING_SECRET=<32+ random characters>
# STORAGE_DIR=/var/lib/aven/files   (dev/test only; production uses object storage, Stage 14)

# --- JARVIS AI (Stage 11) ---
# disabled until the Director supplies a key. "fake" is for tests only and is refused in production.
AI_PROVIDER=disabled
# ANTHROPIC_API_KEY=<server secret, never in the browser>
# ANTHROPIC_MODEL=claude-sonnet-5-5
AI_MAX_TOOL_ROUNDS=5

# --- Voice (Stage 12) ---
STT_PROVIDER=disabled
TTS_PROVIDER=disabled
# PICOVOICE_ACCESS_KEY=<Porcupine licence; released only to consenting JARVIS users>
# WAKE_WORD_MODEL_URL=/wake-word/<trained-phrase>.ppn
VOICE_MAX_CLIP_KB=2048
