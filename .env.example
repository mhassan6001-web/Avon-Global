# Copy to .env for local development. Never commit .env.
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_FORMAT=console
# DATABASE_URL and REDIS_URL are set by docker-compose for the dev containers.
# DATABASE_URL=postgresql+psycopg://aven:aven_dev_password@localhost:5432/aven_global
# REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true
CORS_ORIGINS=http://localhost:3000
DATABASE_STATEMENT_TIMEOUT_MS=15000
READINESS_CHECK_TIMEOUT_SECONDS=2
